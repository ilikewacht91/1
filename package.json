{
  "name": "who-came-wall",
  "version": "1.0.0",
  "private": true,
  "description": "谁来过：一面服务端共享、实时同步的脚印墙",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build-netlify.mjs",
    "netlify:dev": "npx netlify dev",
    "netlify:deploy": "npx netlify deploy --build --prod",
    "cf:dev": "npx wrangler dev",
    "cf:deploy": "npx wrangler deploy",
    "cf:tail": "npx wrangler tail"
  },
  "dependencies": {
    "@netlify/blobs": "8.2.0"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "UNLICENSED"
}
